generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
  SUPERVISOR
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum SupervisionStatus {
  NOT_REQUIRED
  ASSIGNED
  IN_PROGRESS
  AWAITING_SUPERVISOR_REVIEW
  CHANGES_REQUESTED
  SUPERVISOR_APPROVED
  RETURNED_BY_ADMIN
}

enum WorkflowReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  RETURNED_TO_SUPERVISOR
}

enum WorkflowReviewerRole {
  SUPERVISOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServiceCategory {
  CLEANING
  LAUNDRY
  DOMESTIC_SUPPORT
  PEST_CONTROL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  CASUAL
}

enum WorkArrangement {
  ON_SITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  phone          String?
  passwordHash   String?
  role           UserRole      @default(CUSTOMER)
  accountStatus  AccountStatus @default(ACTIVE)
  sessionVersion Int           @default(0)

  bookings                 Booking[]
  bookingsSupervised       Booking[]                  @relation("BookingSupervisor")
  bookingsFinalApproved    Booking[]                  @relation("BookingFinalApprovedBy")
  notifications            Notification[]
  quotesCreated            Quote[]                    @relation("QuotesCreated")
  assignmentsReceived      BookingAssignment[]        @relation("AssignmentStaff")
  assignmentsCreated       BookingAssignment[]        @relation("AssignmentCreatedBy")
  assignmentsUnassigned    BookingAssignment[]        @relation("AssignmentUnassignedBy")
  assignmentSubmissions    AssignmentSubmission[]     @relation("SubmissionAuthor")
  workflowReviews          WorkflowReview[]           @relation("WorkflowReviewer")
  reviews                  Review[]                   @relation("CustomerReviews")
  reviewsModerated         Review[]                   @relation("ReviewsModerated")
  passwordResetTokens      PasswordResetToken[]
  auditLogs                AuditLog[]
  vacanciesCreated         Vacancy[]                  @relation("VacanciesCreated")
  applicationStatusChanges ApplicationStatusHistory[] @relation("AdminStatusChanges")
  retentionPolicyUpdates   AuditRetentionPolicy[]     @relation("RetentionPolicyUpdates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([accountStatus])
}

model Service {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String
  category    ServiceCategory
  imageUrl    String?
  status      ServiceStatus   @default(ACTIVE)

  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model Booking {
  id            String @id @default(uuid())
  bookingNumber String @unique

  customerId String
  serviceId  String

  status BookingStatus @default(PENDING)

  preferredDate DateTime
  preferredTime String

  address             String
  propertyType        String?
  numberOfRooms       Int?
  estimatedSize       String?
  specialInstructions String?
  serviceDetails      Json?

  adminNotes String?

  supervisorId         String?
  supervisorAssignedAt DateTime?
  supervisionStatus    SupervisionStatus @default(NOT_REQUIRED)
  finalApprovedById    String?
  finalApprovedAt      DateTime?
  finalApprovalNote    String?           @db.Text

  customer        User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service         Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  supervisor      User?                  @relation("BookingSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  finalApprovedBy User?                  @relation("BookingFinalApprovedBy", fields: [finalApprovedById], references: [id], onDelete: SetNull)
  quotes          Quote[]
  assignments     BookingAssignment[]
  submissions     AssignmentSubmission[]
  workflowReviews WorkflowReview[]
  review          Review?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@index([preferredDate])
  @@index([supervisorId])
  @@index([supervisionStatus])
  @@index([finalApprovedById])
}

model Notification {
  id String @id @default(uuid())

  userId  String
  title   String
  message String
  type    String
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model ContactMessage {
  id String @id @default(uuid())

  name    String
  email   String
  phone   String?
  subject String
  message String
  status  ContactMessageStatus @default(NEW)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Quote {
  id          String @id @default(uuid())
  quoteNumber String @unique

  bookingId   String
  createdById String

  amount    Decimal @db.Decimal(12, 2)
  currency  String  @default("GHS")
  breakdown Json?
  terms     String? @db.Text

  status       QuoteStatus @default(DRAFT)
  expiresAt    DateTime?
  sentAt       DateTime?
  respondedAt  DateTime?
  responseNote String?     @db.Text

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy User    @relation("QuotesCreated", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revision        Int     @default(1)
  previousQuoteId String?

  previousQuote Quote?  @relation("QuoteRevisions", fields: [previousQuoteId], references: [id], onDelete: SetNull)
  revisions     Quote[] @relation("QuoteRevisions")

  @@unique([previousQuoteId])
  @@index([bookingId, createdAt])
  @@index([createdById])
  @@index([status, expiresAt])
  @@index([bookingId, revision])
}

model BookingAssignment {
  id             String  @id @default(uuid())
  bookingId      String
  staffId        String
  assignedById   String
  unassignedById String?

  status   AssignmentStatus @default(PENDING)
  notes    String?          @db.Text
  isActive Boolean          @default(true)

  assignedAt   DateTime  @default(now())
  startedAt    DateTime?
  submittedAt  DateTime?
  approvedAt   DateTime?
  unassignedAt DateTime?

  booking         Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff           User                   @relation("AssignmentStaff", fields: [staffId], references: [id], onDelete: Restrict)
  assignedBy      User                   @relation("AssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  unassignedBy    User?                  @relation("AssignmentUnassignedBy", fields: [unassignedById], references: [id], onDelete: SetNull)
  submissions     AssignmentSubmission[]
  workflowReviews WorkflowReview[]

  @@index([bookingId, isActive])
  @@index([bookingId, status])
  @@index([staffId, isActive])
  @@index([assignedById])
  @@index([unassignedById])
}

model AssignmentSubmission {
  id            String @id @default(uuid())
  assignmentId  String
  bookingId     String
  submittedById String

  summary       String  @db.Text
  workPerformed String  @db.Text
  issuesNoted   String? @db.Text
  photos        Json?

  assignment  BookingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  submittedBy User              @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([assignmentId, createdAt])
  @@index([bookingId, createdAt])
  @@index([submittedById])
}

model WorkflowReview {
  id           String                 @id @default(uuid())
  bookingId    String
  assignmentId String?
  reviewerId   String
  reviewerRole WorkflowReviewerRole
  decision     WorkflowReviewDecision
  comment      String?                @db.Text

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignment BookingAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  reviewer   User               @relation("WorkflowReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([reviewerId])
}

model Review {
  id         String @id @default(uuid())
  bookingId  String @unique
  customerId String
  serviceId  String

  rating  Int
  comment String?      @db.Text
  status  ReviewStatus @default(PENDING)

  moderationNote String?   @db.Text
  moderatedById  String?
  moderatedAt    DateTime?

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer    User    @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Restrict)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  moderatedBy User?   @relation("ReviewsModerated", fields: [moderatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  reason     String?  @db.Text
  changes    Json?

  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// Singleton row (id = "default") that holds the active retention policy.
model AuditRetentionPolicy {
  id              String    @id @default("default")
  retentionDays   Int       @default(90)   // logs older than this are removed
  enabled         Boolean   @default(true)
  updatedById     String?
  updatedBy       User?     @relation("RetentionPolicyUpdates", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt       DateTime  @updatedAt
  lastRunAt       DateTime?
  lastRunCount    Int?      // how many rows were purged on the last run

  @@index([updatedAt])
}

model Vacancy {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  department       String
  location         String           @default("Accra, Ghana")
  employmentType   EmploymentType   @default(FULL_TIME)
  workArrangement  WorkArrangement  @default(ON_SITE)
  description      String           @db.Text
  responsibilities String           @db.Text
  requirements     String           @db.Text
  skills           String?         @db.Text
  openings         Int              @default(1)
  deadline         DateTime?
  status           VacancyStatus    @default(DRAFT)

  createdById      String?
  createdBy        User?            @relation("VacanciesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  applications     JobApplication[]

  publishedAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([slug])
  @@index([department])
  @@index([deadline])
  @@index([createdAt])
}

model JobApplication {
  id                   String                     @id @default(uuid())
  applicationReference String                     @unique
  vacancyId            String?
  fullName             String
  email                String
  phone                String
  location             String
  coverLetter          String?                    @db.Text

  cvStoragePath        String
  cvFileName           String
  cvMimeType           String
  cvFileSize           Int

  status               ApplicationStatus          @default(SUBMITTED)
  adminNotes           String?                    @db.Text

  vacancy              Vacancy?                   @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  statusHistory        ApplicationStatusHistory[]

  submittedAt          DateTime                   @default(now())
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([applicationReference])
  @@index([email])
  @@index([status])
  @@index([vacancyId])
  @@index([submittedAt])
  @@index([createdAt])
}

model ApplicationStatusHistory {
  id             String             @id @default(uuid())
  applicationId  String
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  actorId        String?
  note           String?            @db.Text

  application    JobApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor          User?              @relation("AdminStatusChanges", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt      DateTime           @default(now())

  @@index([applicationId, createdAt])
  @@index([actorId])
}
